{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prepare:vision-assets": "node scripts/copy-vision-assets.mjs",
    "predev": "npm run prepare:vision-assets",
    "dev": "vite",
    "prebuild": "npm run prepare:vision-assets",
    "build": "vite build",
    "check:entry-bundle": "node scripts/check-entry-bundle.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config=playwright.production.config.js",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "demo:record": "playwright test --config=playwright.demo.config.js",
    "demo:voice": "node e2e-demo/addVoice.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "axios": "^1.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-monaco-editor": "^0.59.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.18"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1"
  }
}
