VITE_API_BASE_URL=/api
# Deploy the same build three times with one of: landing, practice, hiring.
# Leave empty for local development, where all surfaces remain available.
VITE_APP_SURFACE=
VITE_LANDING_ORIGIN=https://evalcueai.com
VITE_PRACTICE_ORIGIN=https://practice.evalcueai.com
VITE_HIRING_ORIGIN=https://hiring.evalcueai.com
# Optional canonical-origin override for single-origin deployments. For the standard
# three-site deployment, Vite uses the correct built-in origin for each app surface.
VITE_PUBLIC_ORIGIN=

# VITE_GOOGLE_CLIENT_ID here is a local-development fallback only; in production
# it's served from the API's /auth/public-config endpoint and configured on Render.
VITE_GOOGLE_CLIENT_ID=
# The CAPTCHA site key is different: it's public but baked in at client build time,
# not served by the API. Set these for real in production too (on every Netlify
# site that renders a login/register form or the candidate assessment flow), so
# rotating the key only needs a client rebuild, not a server change.
VITE_CAPTCHA_PROVIDER=turnstile
VITE_TURNSTILE_SITE_KEY=
VITE_RECAPTCHA_SITE_KEY=
# CAPTCHA is skipped on the local dev server; set true to exercise it locally.
VITE_CAPTCHA_LOCAL_ENABLED=false

VITE_MAX_RESUME_BYTES=5242880
VITE_ACCOUNT_DATA_EXPORT_ENABLED=false
# Public copy (landing pages, SEO, llms.txt) mentions debugging assignments only when true. Turn it on
# together with the server's ENABLE_DEBUGGING_ASSESSMENTS once the code runner is deployed.
VITE_ENABLE_DEBUGGING_ASSESSMENTS=false
# Public EvalcueAI mailboxes. These are safe to expose in browser code.
VITE_CONTACT_EMAIL=contact@evalcueai.com
VITE_SUPPORT_EMAIL=support@evalcueai.com
VITE_SALES_EMAIL=sales@evalcueai.com

# Google Analytics (gtag.js). Leave empty to disable entirely.
VITE_GA_MEASUREMENT_ID=
# Sends real hits from `npm run dev`/localhost too. Leave false so local/test
# traffic doesn't pollute production GA data.
VITE_GA_LOCAL_ENABLED=false
