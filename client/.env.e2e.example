# Copy these values into your CI secret store or export them in your shell.
# Never commit the real shared password.
E2E_SHARED_PASSWORD=
E2E_CANDIDATE_EMAIL=
E2E_HIRING_OWNER_EMAIL=
E2E_HIRING_REVIEWER_EMAIL=
E2E_ADMIN_EMAIL=

# Optional overrides; production EvalcueAI origins are the defaults.
E2E_LANDING_ORIGIN=https://evalcueai.com
E2E_PRACTICE_ORIGIN=https://practice.evalcueai.com
E2E_HIRING_ORIGIN=https://hiring.evalcueai.com
E2E_API_ORIGIN=https://api.evalcueai.com
