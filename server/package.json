{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run src/test/unit",
    "test:e2e": "vitest run src/test/e2e --no-file-parallelism --reporter=verbose",
    "test:launch": "vitest run src/test/e2e/happyFlows.test.js src/test/e2e/progressAnalytics.test.js --reporter=verbose",
    "test:watch": "vitest",
    "dev": "nodemon src/server.js",
    "start": "NODE_ENV=production node src/server.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "audit": "npm audit --omit=dev --audit-level=high",
    "lint:deps": "npm outdated",
    "ci:security": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^11.5.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.3.11",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.11.1",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "node-fetch": "^3.3.2",
    "openai": "^7.30.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.4.299",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0",
    "streamifier": "^0.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.0.0",
    "vitest": "^5.0.3"
  }
