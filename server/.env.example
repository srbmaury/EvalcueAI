# Local development defaults. Production deployments should override these
# values in the platform/secret manager rather than copying this file unchanged.
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/evalcue
MONGO_TLS=false
MONGO_TLS_VALIDATE=true
MONGO_REQUIRE_TRANSACTIONS=false

# JWT / session
JWT_SECRET=change_this_to_a_long_random_secret
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Browser/API origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000
CLIENT_ORIGIN=http://localhost:5173
PRACTICE_CLIENT_ORIGIN=http://localhost:5173
HIRING_CLIENT_ORIGIN=http://localhost:5173
SERVER_ORIGIN=http://localhost:5000

# Redis. Optional locally; required in production for quotas, rate limits and BullMQ.
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=15000
REDIS_RETRY_BASE_MS=500
REDIS_RETRY_MAX_MS=30000

# Email (Brevo HTTPS API). Required in production.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contact@evalcueai.com
BREVO_WEBHOOK_SECRET=
BREVO_SENDER_NAME=EvalcueAI
REMINDER_DELIVERY_ENABLED=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CAPTCHA. The site key is a client build-time value (see client/.env.example's
# VITE_TURNSTILE_SITE_KEY / VITE_RECAPTCHA_SITE_KEY), not configured here.
# CAPTCHA_SECRET is server-only. Keep CAPTCHA disabled locally unless testing it.
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET=
CAPTCHA_LOGIN_ENABLED=false
CAPTCHA_REGISTER_ENABLED=false

# Code execution: the sandboxed runner service in /runner (see runner/README.md).
# Local: cd runner && RUNNER_TOKEN=... docker compose up runner, then CODE_RUNNER_URL=http://127.0.0.1:8080
# Production requires https and a token of at least 32 characters.
ENABLE_CODE_EXEC=false
CODE_RUNNER_URL=
CODE_RUNNER_TOKEN=
CODE_RUNNER_TIMEOUT_MS=90000

# Google OAuth. The browser-safe client ID is exposed by /api/auth/public-config.
GOOGLE_CLIENT_ID=

# Organization OIDC SSO
SSO_ENCRYPTION_KEY=
SSO_ALLOW_NON_ENTERPRISE=false

# Metrics / observability
METRICS_TOKEN=
AUDIT_TTL_SECONDS=7776000
LOG_LEVEL=info
GRAFANA_INSTANCE_ID=
GRAFANA_API_KEY=
GRAFANA_OTLP_URL=https://otlp-gateway-prod-ap-south-0.grafana.net/otlp/v1/metrics
OTEL_SERVICE_NAME=evalcue-server
OTLP_PUSH_INTERVAL_MS=30000

# API rate limiting
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AI_RATE_LIMIT_MAX=30
STT_RATE_LIMIT_MAX=60
CODE_RATE_LIMIT_MAX=20

# Quotas (per-user)
QUOTA_RUN_CODE_PER_HOUR=120
QUOTA_STT_PER_HOUR=120
QUOTA_INTERVIEW_CREATE_PER_HOUR=30
QUOTA_JOB_PREPARE_PER_HOUR=60
QUOTA_JOB_BULK_FEEDBACK_PER_HOUR=60

# Practice plans (user-owned)
FREE_INTERVIEWS_PER_MONTH=3
FREE_RESUME_REVIEWS_PER_MONTH=10
FREE_RESUME_GENERATIONS_PER_MONTH=10
PRO_INTERVIEWS_PER_MONTH=100
PRO_RESUME_REVIEWS_PER_MONTH=100
PRO_RESUME_GENERATIONS_PER_MONTH=100

# Hiring plans (organization-owned)
HIRING_TRIAL_CANDIDATE_INTERVIEWS=5
HIRING_PAID_PILOT_CANDIDATE_INTERVIEWS=15
HIRING_PAID_PILOT_VALID_DAYS=30
HIRING_STARTER_CANDIDATE_INTERVIEWS_PER_MONTH=25
HIRING_GROWTH_CANDIDATE_INTERVIEWS_PER_MONTH=100
HIRING_ENTERPRISE_CANDIDATE_INTERVIEWS_PER_MONTH=100000

# Stripe. Production should configure the complete active catalog.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRACTICE_PRO_PRICE_ID=
STRIPE_HIRING_PILOT_PRICE_ID=
STRIPE_HIRING_STARTER_PRICE_ID=
STRIPE_HIRING_GROWTH_PRICE_ID=

# Antivirus (optional)
ENABLE_AV_SCAN=false
AV_SCAN_URL=

# CSP allowlists for the Express API (comma-separated)
# Add the Google Analytics domains below if VITE_GA_MEASUREMENT_ID is set on the client.
CSP_CONNECT_SRC=https://api.openai.com,https://www.google-analytics.com,https://www.googletagmanager.com
CSP_IMG_SRC=https://res.cloudinary.com
CSP_SCRIPT_SRC=https://www.googletagmanager.com
CSP_STYLE_SRC=

# Feature flags
ENABLE_STT=false
# Debugging rounds stay dark unless explicitly enabled. Code-fix mode also needs ENABLE_CODE_EXEC=true.
ENABLE_DEBUGGING_ASSESSMENTS=false
ACCOUNT_DATA_EXPORT_ENABLED=false
ORIGIN_CHECK_ENFORCE=false

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# AI providers. Configure at least one for AI features.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
WHISPER_MODEL_NAME=whisper-1
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.6-flash
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=1

# Web grounding (Tavily)
TAVILY_API_KEY=
TAVILY_TIMEOUT_MS=8000

# Preview / workers
RESUME_PREVIEW_TIMEOUT_MS=10000
WORKER_CONCURRENCY=2
QUEUE_JOB_TIMEOUT_MS=60000
MAX_RESUME_BYTES=5242880
SHUTDOWN_TIMEOUT_MS=15000

# Admin seed script
ADMIN_EMAIL=
ADMIN_NAME=Admin
ADMIN_PASSWORD=
